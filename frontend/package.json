{
  "name": "call-calendar-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "pnpm --dir ../backend generate:openapi && orval --config orval.config.ts",
    "dev": "vite",
    "build": "pnpm generate && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@mantine/core": "9.7.5",
    "@mantine/hooks": "9.7.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "orval": "8.46.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "postcss": "8.5.32",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": "10.11.0"
  },
  "packageManager": "pnpm@10.11.0"
}
